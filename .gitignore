# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# promo: keep heavy media out of git (host the mp4 on a GitHub Release / YouTube
# and link it). The lightweight script + poster can be committed as documentation.
promo/*.mp4
promo/*.wav
promo/*.mov
